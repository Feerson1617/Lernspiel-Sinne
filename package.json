{
  "name": "mission-sinneslabor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ein zugängliches Biologie-Lernspiel für Klasse 8, ohne externe Laufzeitdienste.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:spec": "cd spec && python3 validate_spec.py",
    "test:browser": "playwright test",
    "check": "npm run test:spec && npm test && npm run build && npm run test:browser",
    "build:scorm": "npm run build && node scripts/build-scorm.mjs",
    "validate:scorm": "python3 scripts/validate_scorm.py",
    "test:scorm:package": "python3 -m unittest discover -s tests -p \"test_scorm_package.py\" -v",
    "test:scorm:browser": "playwright test --config playwright.scorm.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "esbuild": "0.25.12"
  }
}
